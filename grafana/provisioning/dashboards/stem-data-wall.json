{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "schemaVersion": 39,
  "title": "STEM Data Wall — Engineer View",
  "uid": "datawall-main",
  "tags": ["stem-data-wall"],
  "time": { "from": "now-3h", "to": "now" },
