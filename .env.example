# ============================================================================
# stem-data-wall environment template
# ----------------------------------------------------------------------------
# Copy this file to ".env" and fill in real values:
#     cp .env.example .env
#
# NEVER commit your real .env — it is git-ignored on purpose.
# The Ansible "app" role generates a .env for you with random secrets if one
# does not already exist. For a laptop/Docker-only run, copy it by hand and
# set your own passwords (or run `make up`, which creates one if missing).
# ============================================================================

# ---- Admin / staff PIN ------------------------------------------------------
# Used to unlock the /admin page and to authorize scripts/reset_db.py's
# "reset-notify" call. Pick something short the team can remember on the day.
ADMIN_PIN=1234

# ---- Which table/station this Pi represents --------------------------------
# Lets you tell events apart if you ever run more than one table. Any short
# label with no personal data.
STATION=table-1

# ---- Public host name (optional) -------------------------------------------
# The name the /staff page and its QR code advertise for the iPad and Grafana.
# Ansible fills this with the Pi's "<hostname>.local". Leave it BLANK for a
# laptop/Docker run — the pages then fall back to whatever host you opened
# them with (e.g. localhost). Set it to an IP if mDNS names don't resolve.
DATAWALL_HOST=

# ---- MongoDB credentials ----------------------------------------------------
# The "root" user is only used by MongoDB's first-run init to create the
# limited "app" user below. The app and the scripts only ever use the app user.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-root-password
MONGO_APP_USERNAME=datawall_app
MONGO_APP_PASSWORD=change-me-app-password
MONGO_DB=datawall

# ---- Connection strings -----------------------------------------------------
# MONGO_URI: used by the app container. The host name "mongo" is the service
# name inside the docker-compose network — do not change it unless you rename
# the service.
MONGO_URI=mongodb://datawall_app:change-me-app-password@mongo:27017/datawall?authSource=datawall

# MONGO_URI_HOST: used by the Python scripts when they run on the Pi/laptop
# directly (outside Docker). MongoDB's port is bound to 127.0.0.1 only, so this
# never leaves the machine.
MONGO_URI_HOST=mongodb://datawall_app:change-me-app-password@127.0.0.1:27017/datawall?authSource=datawall

# ---- App URL (used by the reset scripts to notify the running app) ----------
APP_URL=http://127.0.0.1:8080
